# Instaladores oficiais e material de análise (grandes; não redistribuir)
vendor/

# Build do Rust
/target/

# Logs de runs reais do harness (token de sessão, certificado, CPF, nome, e-mail)
.logs/

# Relatórios do harness (identificam o titular do certificado)
desktopid-harness-*.txt
desktopid-harness-*.installation-key.pem
remoteid-harness-*.txt
remoteid-harness-*.installation-key.pem
*.installation-key.pem

# Estado local e diagnóstico da instalação (sensíveis)
state.json
diag/

# Bytecode do tools/extract-payloads.py
__pycache__/
*.pyc

# Notas de sessão: raciocínio de trabalho, fora do repositório
# (ficam em ../RemoteID-linux-memoria/). Ver CLAUDE.md.
docs/memoria/

# Estado do agente de código (worktrees e configuração local da ferramenta).
# É ambiente de quem desenvolve, não do projeto, e as worktrees carregam uma
# cópia inteira da árvore: um `git add -A` distraído levaria tudo para o commit.
.claude/
